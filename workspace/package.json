{
  "name": "react-training-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "backend": "cd ../backend && npm start",
    "dev": "vite --port 3000",
    "check": "npm run prettier:check && npm run lint && tsc --build --noEmit",
    "test": "vitest",
    "test:zod": "vitest src/types.test.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "preview": "vite preview",
    "test:unit": "vitest --project unit",
    "test:browser": "vitest --project browser"
  },
